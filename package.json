{
  "name": "pagepress",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Local webpage-to-PDF Chrome extension and companion website by Mulham Kassab.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
