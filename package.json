    "verify": "npm run check && npm run lint && npm test && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "playwright": "1.62.1"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
