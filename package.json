{
  "name": "pagepress",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Local webpage-to-PDF Chrome extension and companion website by Mulham Kassab.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "package": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "fflate": "0.8.2"
  }
}
